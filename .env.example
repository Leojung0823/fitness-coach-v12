# Local Supabase connection (see README.md for how to get these values from
# `npx supabase status` after `npx supabase start`).
#
# These are PUBLIC values by design (anon key is safe to ship to the
# browser) — the real security boundary is Postgres Row Level Security,
# not these variables. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
